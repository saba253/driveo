# DRIVEO — environment variables (copy to .env.local; never commit real values)
#
# Google Maps Platform — Routes API (server-side only)
# Live requests stay OFF unless GOOGLE_ROUTES_ENABLED is exactly "true"
# AND GOOGLE_MAPS_SERVER_API_KEY is set. Never put a Maps key in a
# NEXT_PUBLIC_ variable: the server refuses to route if one exists.
GOOGLE_ROUTES_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=

# Optional tuning (defaults shown). Values are clamped to safe ranges.
GOOGLE_ROUTES_TIMEOUT_MS=5000
GOOGLE_ROUTES_MAX_RETRIES=1

# Internal safety caps on provider calls (UTC day / month), independent of
# Google's own quotas. Proposed defaults — well below the free monthly allowance.
GOOGLE_ROUTES_DAILY_LIMIT=100
GOOGLE_ROUTES_MONTHLY_LIMIT=2000

# Quote requests allowed per client per minute (future quote endpoint).
ROUTE_QUOTES_PER_CLIENT_PER_MINUTE=5

# Quote orchestration (Step 1.6C.2). Development only:
# QUOTE_ROUTING_MODE=mock uses the MOCK route provider (never real distances);
# any other value disables routing. Ignored in production.
QUOTE_ROUTING_MODE=disabled
# JSON map of "originPlaceId->destinationPlaceId" to {"distanceKm":..,"durationMinutes":..}
QUOTE_MOCK_ROUTES=

# Supabase (Step 1.7B). Leave empty until the founder connects the DEVELOPMENT
# project (docs/supabase-setup.md): the admin area then shows "not configured"
# and nothing connects. Server-only names on purpose — DRIVEO never uses
# Supabase from the browser, so nothing here may carry a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Production only: admin login stays OFF in production unless this is exactly
# "true" — set it only after persistent rate limiting and CAPTCHA are live.
ADMIN_AUTH_PRODUCTION_ENABLED=false
# NOT used by the app yet. Secret key (sb_secret_...): server-only, never
# NEXT_PUBLIC_, never pasted into chats, tickets or screenshots. Needed only for
# the optional --with-test-booking live check.
# SUPABASE_SECRET_KEY=

# Live security check only (scripts/live-security-check.ts), DEVELOPMENT project.
# DRIVEO_LIVE_TARGET=development
# DRIVEO_LIVE_PROJECT_REF=
