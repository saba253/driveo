# DRIVEO — environment variables (copy to .env.local; never commit real values)
#
# Google Maps Platform — Routes API (server-side only)
# Live requests stay OFF unless GOOGLE_ROUTES_ENABLED is exactly "true"
# AND GOOGLE_MAPS_SERVER_API_KEY is set. Never put a Maps key in a
# NEXT_PUBLIC_ variable: the server refuses to route if one exists.
GOOGLE_ROUTES_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=

# Optional tuning (defaults shown). Values are clamped to safe ranges.
GOOGLE_ROUTES_TIMEOUT_MS=5000
GOOGLE_ROUTES_MAX_RETRIES=1

# Internal safety caps on provider calls (UTC day / month), independent of
# Google's own quotas. Proposed defaults — well below the free monthly allowance.
GOOGLE_ROUTES_DAILY_LIMIT=100
GOOGLE_ROUTES_MONTHLY_LIMIT=2000

# Quote requests allowed per client per minute (future quote endpoint).
ROUTE_QUOTES_PER_CLIENT_PER_MINUTE=5
